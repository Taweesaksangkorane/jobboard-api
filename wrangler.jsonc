{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team18-job-board",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team18-job-board-db",
      "database_id": "7171fd10-22f9-4053-9d21-70231a1ebdae",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
