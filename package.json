{
  "name": "job-board-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "npm run cf:dev",
    "dev": "wrangler dev",
    "test": "npm run test:worker && npm run frontend:lint && npm run frontend:build && wrangler deploy --dry-run",
    "test:worker": "node --test tests/worker.test.mjs",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "cf:dev": "npm run frontend:build && wrangler dev",
    "cf:db:local": "wrangler d1 migrations apply DB --local",
    "cf:db:remote": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "npm run frontend:build && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
