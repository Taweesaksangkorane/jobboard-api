{
  "name": "job-board-api",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "npm run cf:dev",
    "dev": "wrangler dev",
    "test": "npm run frontend:lint && npm run frontend:build && wrangler deploy --dry-run",
    "legacy:start": "node server.js",
    "legacy:test": "jest --runInBand",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "cf:dev": "npm run frontend:build && wrangler dev",
    "cf:db:local": "wrangler d1 migrations apply DB --local",
    "cf:db:remote": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "npm run frontend:build && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "wrangler": "^4.156.2"
  }
}
