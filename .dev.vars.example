# Authentication Secrets (Session HMAC and Demo Accounts)
AUTH_SESSION_SECRET=replace-with-a-random-32-byte-secret-for-session-signing
DEMO_STUDENT_EMAIL=student-demo@example.com
DEMO_STUDENT_PASSWORD=replace-with-demo-student-password
DEMO_EMPLOYER_EMAIL=employer-demo@example.com
DEMO_EMPLOYER_PASSWORD=replace-with-demo-employer-password

# Webhook Secrets & Service URLs
WEBHOOK_SECRET=replace-with-a-random-secret
EVENT_WEBHOOK_SECRET=replace-with-the-same-shared-secret-if-required-by-the-partner
NOTIFICATION_SERVICE_URL=https://notification-service.example.com
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173,http://127.0.0.1:5173
